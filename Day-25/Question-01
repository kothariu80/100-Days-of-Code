#include <stdio.h>

int main() {
    int i, j;
    
    // Outer loop for rows from 5 down to 1
    for (i = 5; i >= 1; i--) {
        // Inner loop to print numbers from i up to 5
        for (j = i; j <= 5; j++) {
            printf("%d", j);
        }
        printf("\n"); // Move to the next line
    }
    
    return 0;
}
