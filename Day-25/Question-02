#include <stdio.h>

int main() {
    int rows = 5;

    // Outer loop for the number of rows
    for (int i = 0; i < rows; i++) {
        
        // Inner loop 1: Print leading spaces
        for (int j = 0; j < i; j++) {
            printf(" ");
        }
        
        // Inner loop 2: Print stars
        for (int k = 0; k < rows - i; k++) {
            printf("*");
        }
        
        printf("\n");
    }

    return 0;
}
