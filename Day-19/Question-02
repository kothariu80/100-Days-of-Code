#include <stdio.h>
#include <stdlib.h>

int main() {
    int num, temp, remainder;
    int sum = 0;

    printf("Enter an integer: ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input. Please enter a valid integer.\n");
        return 1;
    }

    // Store the original number in a temporary variable for output formatting
    temp = num;

    if (num < 0) {
        num = abs(num);
    }

    while (num > 0) {
        remainder = num % 10;  // Extract the last digit
        sum = sum + remainder; // Add the digit to sum
        num = num / 10;        // Remove the last digit from the number
    }

    printf("The sum of the digits of %d is: %d\n", temp, sum);

    return 0;
}
