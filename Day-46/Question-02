#include <stdio.h>
#include <string.h>

// Approach 1: Finds the character whose SECOND occurrence appears first
char findFirstDuplicateOccurrence(const char* str) {
    // Array to track if a lowercase character ('a' to 'z') has been seen
    int seen[26] = {0}; 
    
    for (int i = 0; str[i] != '\0'; i++) {
        // Process only lowercase alphabet characters
        if (str[i] >= 'a' && str[i] <= 'z') {
            int index = str[i] - 'a';
            
            // If we have already seen this character, it's our first duplicate
            if (seen[index] == 1) {
                return str[i];
            }
            // Mark the character as seen
            seen[index] = 1;
        }
    }
    return '\0'; // Return null character if no repeating character is found
}

// Approach 2: Finds the repeating character that has the EARLIEST initial index
char findFirstInitialOccurrence(const char* str) {
    int counts[26] = {0};
    
    // Step 1: Count frequencies of all lowercase characters
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] >= 'a' && str[i] <= 'z') {
            counts[str[i] - 'a']++;
        }
    }
    
    // Step 2: Traverse string again to find the first character with a count > 1
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] >= 'a' && str[i] <= 'z') {
            if (counts[str[i] - 'a'] > 1) {
                return str[i];
            }
        }
    }
    return '\0';
}

int main() {
    char str[100];
    
    printf("Enter a string: ");
    if (scanf("%99s", str) != 1) {
        return 1;
    }
    
    // Test Approach 1
    char res1 = findFirstDuplicateOccurrence(str);
    if (res1 != '\0') {
        printf("1. First by duplicate occurrence: '%c'\n", res1);
    } else {
        printf("1. No repeating lowercase alphabet found.\n");
    }
    
    // Test Approach 2
    char res2 = findFirstInitialOccurrence(str);
    if (res2 != '\0') {
        printf("2. First by initial occurrence: '%c'\n", res2);
    } else {
        printf("2. No repeating lowercase alphabet found.\n");
    }
    
    return 0;
}
