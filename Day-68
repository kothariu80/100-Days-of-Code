#include <stdio.h>

int main() {
    int n;
    
    scanf("%d", &n);

    int arr[n];
    int sum = 0;

    // Input n numbers
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    // Sum of numbers from 0 to n
    int expectedSum = n * (n + 1) / 2;

    // Find missing number
    int missing = expectedSum - sum;

    printf("%d", missing);

    return 0;
}
