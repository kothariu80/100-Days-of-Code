#include <stdio.h>

int main() {
    int num, temp;
    int binary[32]; // Array to store binary digits
    int i = 0;

    // Prompt user for input
    printf("Enter a decimal number: ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }
    if (num == 0) {
        printf("Binary equivalent: 0\n");
        return 0;
    }

    // Keep a copy of the original number for the output message
    temp = num; 
    if (num < 0) {
        printf("Please enter a positive integer.\n");
        return 1;
    }
    while (num > 0) {
        binary[i] = num % 2; // Store the remainder (0 or 1)
        num = num / 2;       // Divide the number by 2
        i++;                 // Move to the next array index
    }

    printf("Binary equivalent of %d is: ", temp);
    for (int j = i - 1; j >= 0; j--) {
        printf("%d", binary[j]);
    }
    printf("\n");

    return 0;
}
