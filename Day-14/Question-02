#include <stdio.h>

int main() {
    int n;
    long long product = 1;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    // Check if n is less than 2, as no even numbers exist in the range [1, n]
    if (n < 2) {
        printf("There are no even numbers between 1 and %d to multiply.\n", n);
        return 0;
    }

    // Loop through even numbers starting from 2 up to n, incrementing by 2
    for (int i = 2; i <= n; i += 2) {
        product *= i;
    }

    // Print the final result
    printf("The product of even numbers from 1 to %d is: %lld\n", n, product);

    return 0;
}
