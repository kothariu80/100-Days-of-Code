#include <stdio.h>

int main() {
    int n, i;
    int sum = 0;
    int current_odd = 1;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        sum += current_odd;
        current_odd += 2; // Move to the next odd number
    }
    printf("The sum of the first %d odd numbers is: %d\n", n, sum);

    return 0;
}
