#include <stdio.h>
#include <stdlib.h>

int main() {
    long long num;
    int digit_counts[10] = {0}; // 1D array to store frequency of digits 0-9
    int max_count = 0;
    int most_frequent_digit = 0;

    printf("Enter an integer: ");
    if (scanf("%lld", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    // Convert negative number to positive to handle digits correctly
    long long temp = llabs(num);

    // Handle the special case where the input number is 0
    if (temp == 0) {
        digit_counts[0] = 1;
    }

    // Extract digits and update their counts in the 1D array
    while (temp > 0) {
        int digit = temp % 10;
        digit_counts[digit]++;
        temp /= 10;
    }

    // Find the digit with the maximum frequency
    // Scanning from 0 to 9 ensures we pick the smallest digit in case of a tie
    for (int i = 0; i < 10; i++) {
        if (digit_counts[i] > max_count) {
            max_count = digit_counts[i];
            most_frequent_digit = i;
        }
    }

    // Print the results
    printf("The most frequent digit is %d (occurs %d times).\n", most_frequent_digit, max_count);

    return 0;
}
