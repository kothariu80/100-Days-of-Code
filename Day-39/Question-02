#include <stdio.h>

int main() {
    int n, i, sum = 0;

    // 1. Get the size of the square matrix
    printf("Enter the size of the square matrix (N x N): ");
    scanf("%d", &n);

    int matrix[n][n];

    // 2. Input the matrix elements from the user
    printf("Enter the elements of the matrix:\n");
    for (i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            printf("Element [%d][%d]: ", i, j);
            scanf("%d", &matrix[i][j]);
        }
    }

    // 3. Calculate the sum of the main diagonal elements
    // We use a single loop since row index == column index for the main diagonal
    for (i = 0; i < n; i++) {
        sum += matrix[i][i];
    }

    // 4. Output the result
    printf("\nThe sum of the main diagonal elements is: %d\n", sum);

    return 0;
}
