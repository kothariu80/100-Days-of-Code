#include <stdio.h>

int main() {
    int n, i;

    // Prompt the user to enter the value of N
    printf("Enter the value of n: ");
    scanf("%d", &n);

    // Loop from 1 to n and print each number
    printf("Numbers from 1 to %d are:\n", n);
    for(i = 1; i <= n; i++) {
        printf("%d ", i);
    }

    printf("\n");
    return 0;
}
