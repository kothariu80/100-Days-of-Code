#include <stdio.h>

int main() {
    int n, i, j, isPrime;

    // Get the upper limit from the user
    printf("Enter the value of n: ");
    scanf("%d", &n);

    printf("Prime numbers between 1 and %d are:\n", n);

    // Loop through all numbers from 2 to n (1 is neither prime nor composite)
    for (i = 2; i <= n; i++) {
        isPrime = 1; // Assume the current number i is prime

        // Check if i is divisible by any number from 2 up to i/2 (or sqrt(i))
        for (j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                isPrime = 0; // Number is divisible, so it is not prime
                break;       // Exit the inner loop early
            }
        }

        // If isPrime is still 1, the number is prime
        if (isPrime == 1) {
            printf("%d ", i);
        }
    }

    printf("\n");
    return 0;
}
