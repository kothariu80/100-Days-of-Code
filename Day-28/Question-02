#include <stdio.h>

int main() {
    int n, i;

    // 1. Ask the user for the size of the array
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    // Declare the array with the user-defined size
    int arr[n];

    // 2. Read elements into the array from the user
    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr[i]);
    }

    // 3. Print the elements of the array
    printf("\nThe elements of the array are: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
