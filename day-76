#include <stdio.h>
#include <ctype.h>

int main() {
    FILE *input, *output;
    char ch;

    input = fopen("input.txt", "r");

    if (input == NULL) {
        printf("Error: input.txt could not be opened.\n");
        return 1;
    }

    output = fopen("output.txt", "w");

    if (output == NULL) {
        printf("Error: output.txt could not be opened.\n");
        fclose(input);
        return 1;
    }

    while ((ch = fgetc(input)) != EOF) {
        ch = toupper(ch);
        fputc(ch, output);
    }

    fclose(input);
    fclose(output);

    printf("Text converted to uppercase and written to output.txt.\n");

    return 0;
}
