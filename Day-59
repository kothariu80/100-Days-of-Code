#include <stdio.h>
#include <stdlib.h>

void printMaxSubarraySum(int arr[], int n, int k) {
    // If the array size is smaller than the window size k, it's invalid
    if (n < k || k <= 0) {
        printf("Invalid subarray size.\n");
        return;
    }

    // Compute the sum of the first window of size k
    long long current_sum = 0;
    for (int i = 0; i < k; i++) {
        current_sum += arr[i];
    }

    long long max_sum = current_sum;

    // Slide the window across the array from index k to n-1
    for (int i = k; i < n; i++) {
        // Subtract the element that rolls out, add the element that rolls in
        current_sum += arr[i] - arr[i - k];
        
        // Update max_sum if the current window sum is larger
        if (current_sum > max_sum) {
            max_sum = current_sum;
        }
    }

    printf("Maximum sum of a subarray of size %d is: %lld\n", k, max_sum);
}

int main() {
    int n, k;

    // Take array size input
    printf("Enter the number of elements in the array: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid array size.\n");
        return 1;
    }

    int *arr = (int *)malloc(n * sizeof(int));
    if (arr == NULL) {
        printf("Memory allocation failed.\n");
        return 1;
    }

    // Take array elements input
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Take subarray size k input
    printf("Enter the subarray size (k): ");
    scanf("%d", &k);

    // Calculate and print the maximum subarray sum
    printMaxSubarraySum(arr, n, k);

    // Free dynamically allocated memory
    free(arr);

    return 0;
}
