#include <stdio.h>
#include <ctype.h>

void printInitials(char *name) {
    int i = 0;

    // Handle the first character if it's not a space
    if (name[0] != '\0' && name[0] != ' ') {
        printf("%c", toupper(name[0]));
    }

    // Traverse the rest of the string
    while (name[i] != '\0') {
        // If a space is found, the next character is the starting of a new word
        if (name[i] == ' ') {
            // Check if the next character is not a space or null terminator
            if (name[i + 1] != ' ' && name[i + 1] != '\0') {
                printf(". %c", toupper(name[i + 1]));
            }
        }
        i++;
    }
    printf("\n");
}

int main() {
    char name[100];

    printf("Enter your full name: ");
    // Reads the entire line including spaces
    fgets(name, sizeof(name), stdin);

    printf("Your initials: ");
    printInitials(name);

    return 0;
}
