#include <stdio.h>
#include <string.h>

void printAllSubstrings(char str[]) {
    int len = strlen(str);

    printf("All substrings of \"%s\" are:\n", str);

    // 1. Outer loop selects the starting character
    for (int i = 0; i < len; i++) {
        
        // 2. Middle loop selects the ending character
        for (int j = i; j < len; j++) {
            
            // 3. Inner loop prints characters from index 'i' to 'j'
            for (int k = i; k <= j; k++) {
                printf("%c", str[k]);
            }
            printf("\n"); // Move to the next line for each substring
        }
    }
}

int main() {
    char str[] = "abc";
    printAllSubstrings(str);
    return 0;
}
