#include <stdio.h>

int main() {
    int total_seconds;
    int hours, minutes, seconds;

    printf("Enter time in seconds: ");
    if (scanf("%d", &total_seconds) != 1 || total_seconds < 0) {
        printf("enter a valid positive integer.\n");
        return 1;
    }

    hours = total_seconds / 3600;         // 1 hour = 3600 seconds
    minutes = (total_seconds % 3600) / 60; // Remaining seconds divided by 60
    seconds = total_seconds % 60;          // Remainder yields leftover seconds

    printf("Formatted time: %02d:%02d:%02d\n", hours, minutes, seconds);

    return 0;
}
