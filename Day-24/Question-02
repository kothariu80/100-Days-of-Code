#include <stdio.h>

int main() {
    int i, j;
    
    // Outer loop for the rows
    for (i = 1; i <= 5; i++) {
        // Inner loop for the numbers in each row
        for (j = 1; j <= i; j++) {
            printf("%d", j);
        }
        // Move to the next line
        printf("\n");
    }
    
    return 0;
}
