#include <stdio.h>

int main() {
    int i, j;
    int rows = 5; // Defines the total number of rows

    for (i = 1; i <= rows; i++) {
        
        // Inner loop to handle the number of stars in each row
        for (j = 1; j <= i; j++) {
            printf("*");
        }
        
        printf("\n");
    }

    return 0;
}
