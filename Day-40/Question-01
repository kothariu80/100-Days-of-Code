#include <stdio.h>

#define ROW 3
#define COL 3

void findDiagonalOrder(int mat[ROW][COL]) {
    int r = 0, c = 0;
    int up = 1; // 1 means moving up-right, 0 means moving down-left

    for (int k = 0; k < ROW * COL; k++) {
        printf("%d ", mat[r][c]);

        if (up) {
            if (c == COL - 1) {
                r++;
                up = 0;
            } else if (r == 0) {
                c++;
                up = 0;
            } else {
                r--;
                c++;
            }
        } else {
            if (r == ROW - 1) {
                c++;
                up = 1;
            } else if (c == 0) {
                r++;
                up = 1;
            } else {
                r++;
                c--;
            }
        }
    }
    printf("\n");
}

int main() {
    int mat[ROW][COL] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    printf("Diagonal Traversal Output:\n");
    findDiagonalOrder(mat);

    return 0;
}
