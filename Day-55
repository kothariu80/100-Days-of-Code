#include <stdio.h>

// Function to find the majority element
int findMajorityElement(int nums[], int n) {
    if (n == 0) return -1;

    int candidate = nums[0];
    int count = 1;

    // Phase 1: Find a potential candidate
    for (int i = 1; i < n; i++) {
        if (count == 0) {
            candidate = nums[i];
            count = 1;
        } else if (nums[i] == candidate) {
            count++;
        } else {
            count--;
        }
    }

    // Phase 2: Verify if the candidate is strictly a majority element (> n / 2)
    int actualCount = 0;
    for (int i = 0; i < n; i++) {
        if (nums[i] == candidate) {
            actualCount++;
        }
    }

    if (actualCount > n / 2) {
        return candidate;
    } else {
        return -1;
    }
}

int main() {
    int n;

    printf("Enter the size of the array: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("-1\n");
        return 0;
    }

    int nums[n];
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &nums[i]);
    }

    // Find and print the result
    int result = findMajorityElement(nums, n);
    printf("Majority Element: %d\n", result);

    return 0;
}
