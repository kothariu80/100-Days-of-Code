#include <stdio.h>

// Function to perform linear search
int linearSearch(int arr[], int size, int key) {
    // Loop through each element of the array sequentially
    for (int i = 0; i < size; i++) {
        if (arr[i] == key) {
            return i; // Return the 0-based index if a match is found
        }
    }
    return -1; // Return -1 if the element is not in the array
}

int main() {
    int size, key, resultIndex;

    // 1. Get the size of the array from the user
    printf("Enter the number of elements in the array: ");
    scanf("%d", &size);

    int arr[size]; // Declare the 1D array

    // 2. Input array elements
    printf("Enter %d integers:\n", size);
    for (int i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }

    // 3. Get the element to search for
    printf("Enter the element to search for: ");
    scanf("%d", &key);

    // 4. Call the linear search function
    resultIndex = linearSearch(arr, size, key);

    // 5. Display the result
    if (resultIndex != -1) {
        printf("Element %d found at index %d (Position %d).\n", key, resultIndex, resultIndex + 1);
    } else {
        printf("Element %d not found in the array.\n", key);
    }

    return 0;
}
