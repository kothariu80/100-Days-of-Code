#include <stdio.h>
#include <string.h>

// Function to reverse a specific segment of a string in-place
void reverse(char *begin, char *end) {
    char temp;
    while (begin < end) {
        temp = *begin;
        *begin++ = *end;
        *end-- = temp;
    }
}

// Function to locate word boundaries and reverse each word
void reverseEachWord(char *str) {
    char *word_begin = str;
    char *temp = str;

    while (*temp) {
        temp++;
        
        // If we hit a space, it marks the end of a word
        if (*temp == ' ') {
            reverse(word_begin, temp - 1);
            word_begin = temp + 1; // Move to the start of the next word
        }
        // If we hit the null-terminator, it marks the end of the last word
        else if (*temp == '\0') {
            reverse(word_begin, temp - 1);
        }
    }
}

int main() {
    // Character array initialized with a sample sentence
    char sentence[] = "Hello World from C Programming";

    printf("Original Sentence: %s\n", sentence);

    // Call the function to reverse individual words
    reverseEachWord(sentence);

    printf("Modified Sentence: %s\n", sentence);

    return 0;
}
