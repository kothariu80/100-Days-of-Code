#include <stdio.h>

void findNextGreaterElement(int arr[], int n) {
    // Outer loop picks each element one by one
    for (int i = 0; i < n; i++) {
        int nextGreater = -1; // Default if no greater element is found

        // Inner loop finds the next greater element on the right
        for (int j = i + 1; j < n; j++) {
            if (arr[j] > arr[i]) {
                nextGreater = arr[j];
                break; // Break as we need the *nearest* greater element
            }
        }

        // Print the result in a comma-separated fashion
        if (i == n - 1) {
            printf("%d", nextGreater); // Last element doesn't need a trailing comma
        } else {
            printf("%d, ", nextGreater);
        }
    }
    printf("\n");
}

int main() {
    int n;

    // Take the size of the array as input
    printf("Enter the number of elements: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid array size.\n");
        return 1;
    }

    int arr[n];

    // Take array elements as input
    printf("Enter %d integers:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Next Greater Elements: ");
    findNextGreaterElement(arr, n);

    return 0;
}
