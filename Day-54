#include <stdio.h>

int main() {
    int n;
    
    // Take a positive integer input from the user
    printf("Enter a positive integer n: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("-1\n");
        return 0;
    }

    // Calculate the total sum of elements from 1 to n
    int total_sum = (n * (n + 1)) / 2;
    int left_sum = 0;
    int pivot = -1;

    // Iterate through each possible pivot x
    for (int x = 1; x <= n; x++) {
        left_sum += x;
        
        // Right sum includes x, so it is total_sum - left_sum + x
        int right_sum = total_sum - left_sum + x;

        // Check if the condition is met
        if (left_sum == right_sum) {
            pivot = x;
            break; // Since at most one pivot exists, we can stop early
        }
    }

    // Print the result
    printf("%d\n", pivot);

    return 0;
}
