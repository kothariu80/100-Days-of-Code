#include <stdio.h>

int main() {
    int rows = 5;
    int columns = 5;

    for (int i = 0; i < rows; i++) {
        // Inner loop for columns
        for (int j = 0; j < columns; j++) {
            printf("*");
        }
        // Move to the next line after printing all stars in a row
        printf("\n");
    }

    return 0;
}
