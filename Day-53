#include <stdio.h>

// Function to find the pivot index
int findPivotIndex(int arr[], int size) {
    int totalSum = 0;
    int leftSum = 0;

    // Calculate the total sum of the array
    for (int i = 0; i < size; i++) {
        totalSum += arr[i];
    }

    // Traverse the array to find the pivot index
    for (int i = 0; i < size; i++) {
        // Right sum is totalSum - leftSum - current element
        if (leftSum == (totalSum - leftSum - arr[i])) {
            return i; // Found the leftmost pivot index
        }
        leftSum += arr[i];
    }

    return -1; // No pivot index found
}

int main() {
    int n;

    // Take array size as input
    printf("Enter the number of elements in the array: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid array size.\n");
        return 1;
    }

    int arr[n];

    // Take array elements as input
    printf("Enter %d integers:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Calculate and print the pivot index
    int pivot = findPivotIndex(arr, n);
    printf("Pivot Index: %d\n", pivot);

    return 0;
}
