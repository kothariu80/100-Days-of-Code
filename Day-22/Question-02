#include <stdio.h>

int main() {
    int n;
    double sum = 0.0;

    // Prompt user for the number of terms
    printf("Enter the number of terms (n): ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Please enter a valid positive integer.\n");
        return 1;
    }

    // Loop to calculate the sum of n terms
    for (int i = 1; i <= n; i++) {
        if (i == 1) {
            sum += 1.0; // The first term is explicitly 1
        } else {
            // For i >= 2, the term is (2i - 1) / (2i)
            double numerator = 2 * i - 1;
            double denominator = 2 * i;
            sum += numerator / denominator;
        }
    }

    printf("The sum of the series up to %d terms is: %.6lf\n", n, sum);

    return 0;
}
