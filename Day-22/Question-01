#include <stdio.h>

// Helper function to calculate the factorial of a digit
long long getFactorial(int digit) {
    long long fact = 1;
    for (int i = 1; i <= digit; i++) {
        fact *= i;
    }
    return fact;
}

int main() {
    int num, originalNum, lastDigit;
    long long sum = 0;

    // Get input from the user
    printf("Enter an integer to check: ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    // Keep a copy of the original number for comparison
    originalNum = num;

    // Edge case for negative numbers
    if (num < 0) {
        printf("%d is not a strong number.\n", originalNum);
        return 0;
    }

    // Process every digit of the number
    while (num > 0) {
        // Extract the last digit
        lastDigit = num % 10;
        
        // Add the factorial of the digit to sum
        sum += getFactorial(lastDigit);
        
        // Remove the last digit from the number
        num /= 10;
    }

    // Check if the sum of factorials matches the original number
    if (sum == originalNum) {
        printf("%d is a Strong Number.\n", originalNum);
    } else {
        printf("%d is not a Strong Number.\n", originalNum);
    }

    return 0;
}
