#include <stdio.h>

int main() {
    int m, n;

    // Input size of first array
    scanf("%d", &m);
    int a[m];

    // Input first sorted array
    for (int i = 0; i < m; i++) {
        scanf("%d", &a[i]);
    }

    // Input size of second array
    scanf("%d", &n);
    int b[n];

    // Input second sorted array
    for (int i = 0; i < n; i++) {
        scanf("%d", &b[i]);
    }

    int merged[m + n];
    int i = 0, j = 0, k = 0;

    // Merge both arrays
    while (i < m && j < n) {
        if (a[i] <= b[j]) {
            merged[k] = a[i];
            i++;
        } else {
            merged[k] = b[j];
            j++;
        }
        k++;
    }

    // Copy remaining elements of first array
    while (i < m) {
        merged[k] = a[i];
        i++;
        k++;
    }

    // Copy remaining elements of second array
    while (j < n) {
        merged[k] = b[j];
        j++;
        k++;
    }

    // Print merged array
    for (i = 0; i < m + n; i++) {
        printf("%d ", merged[i]);
    }

    return 0;
}
