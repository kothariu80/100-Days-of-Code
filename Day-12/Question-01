#include <stdio.h>

int main() {
    int days;
    int fine = 0;

    printf("Enter the number of days late: ");
    if (scanf("%d", &days) != 1 || days < 0) {
        printf("Invalid input. Days late cannot be negative.\n");
        return 1;
    }

    if (days <= 0) {
        printf("No fine. Book returned on time.\n");
    } 
    else if (days > 30) {
        printf("Late for more than 30 days: Membership Cancelled.\n");
    } 
    else {
        if (days <= 5) {
            fine = days * 2;
        } 
        else if (days <= 10) {
            // First 5 days @ ₹2 + remaining days @ ₹4
            fine = (5 * 2) + ((days - 5) * 4);
        } 
        else { // Days are between 11 and 30
            // First 5 days @ ₹2 + Next 5 days @ ₹4 + remaining days @ ₹6
            fine = (5 * 2) + (5 * 4) + ((days - 10) * 6);
        }
        
        printf("Total Library Fine: ₹%d\n", fine);
    }

    return 0;
}
